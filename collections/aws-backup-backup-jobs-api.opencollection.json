        },
        {
          "info": {
            "name": "Stop a backup job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://backup.{region}.amazonaws.com/backup-jobs/:backupJobId",
            "params": [
              {
                "name": "backupJobId",
